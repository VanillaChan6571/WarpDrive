{
  "multipart": [
    {
      "when": { "connected": "false" },
      "apply": { "model": "warpdrive:block/catalog/cloaking_coil" }
    },
    {
      "when": { "connected": "true", "outer": "false", "active": "false" },
      "apply": { "model": "warpdrive:block/catalog/cloaking_coil_channeling_inactive" }
    },
    {
      "when": { "connected": "true", "outer": "false", "active": "true" },
      "apply": { "model": "warpdrive:block/catalog/cloaking_coil_channeling_active" }
    },
    {
      "when": { "connected": "true", "outer": "true", "active": "false" },
      "apply": { "model": "warpdrive:block/catalog/cloaking_coil" }
    },
    {
      "when": { "connected": "true", "outer": "true", "active": "true" },
      "apply": { "model": "warpdrive:block/catalog/cloaking_coil_projecting_active" }
    }
  ]
}
