{
  "multipart": [
    { "when": { "orientation": "down_north" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "x": 180, "y": 180 } },
    { "when": { "orientation": "down_south" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "x": 180 } },
    { "when": { "orientation": "down_west" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "x": 180, "y": 90 } },
    { "when": { "orientation": "down_east" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "x": 180, "y": 270 } },
    { "when": { "orientation": "up_north" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "y": 180 } },
    { "when": { "orientation": "up_south" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic" } },
    { "when": { "orientation": "up_west" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "y": 90 } },
    { "when": { "orientation": "up_east" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "y": 270 } },
    { "when": { "orientation": "north" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "x": 90 } },
    { "when": { "orientation": "south" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "x": 90, "y": 180 } },
    { "when": { "orientation": "west" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "x": 90, "y": 270 } },
    { "when": { "orientation": "east" }, "apply": { "model": "warpdrive:block/detection/siren_industrial.basic", "x": 90, "y": 90 } }
  ]
}
