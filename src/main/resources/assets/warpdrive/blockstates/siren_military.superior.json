    { "when": { "orientation": "down_south" }, "apply": { "model": "warpdrive:block/detection/siren_military.superior-vertical", "x": 180 } },
    { "when": { "orientation": "down_west" }, "apply": { "model": "warpdrive:block/detection/siren_military.superior-vertical", "x": 180 } },
    { "when": { "orientation": "down_east" }, "apply": { "model": "warpdrive:block/detection/siren_military.superior-vertical", "x": 180 } },
    { "when": { "orientation": "up_north" }, "apply": { "model": "warpdrive:block/detection/siren_military.superior-vertical" } },
